{
  "name": "vellox",
  "version": "0.7.0",
  "description": "Local structural analyzer for JavaScript, TypeScript, Python, and SQL performance risks",
  "bin": {
    "vellox": "dist/bin.js"
  },
  "main": "./dist/bin.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/bin.ts --format cjs,esm --clean",
    "start": "node ./dist/bin.js",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guimenn/Vellox.git",
    "directory": "packages/cli"
  },
  "homepage": "https://guimenn.github.io/Vellox/",
  "bugs": {
    "url": "https://github.com/Guimenn/Vellox/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "vellox",
    "finops",
    "performance",
    "database-optimizer",
    "sql",
    "static-analysis",
    "javascript",
    "typescript",
    "python",
    "ast",
    "async",
    "performance-linter",
    "docker",
    "kubernetes",
    "terraform",
    "sarif",
    "prisma",
    "nplus1",
    "postgres",
    "mysql",
    "mongodb",
    "redis",
    "cli"
  ],
  "author": "Guilherme Men",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@lezer/python": "^1.1.19",
    "ignore": "^7.0.8"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
