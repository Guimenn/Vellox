{
  "name": "vellox",
  "version": "0.3.0",
  "description": "Local evidence-first scanner for code, SQL, ORM schemas, and CI",
  "bin": {
    "vellox": "dist/bin.js"
  },
  "main": "./dist/bin.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/bin.ts --format cjs,esm --clean",
    "start": "node ./dist/bin.js",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guimenn/Vellox.git",
    "directory": "packages/cli"
  },
  "homepage": "https://guimenn.github.io/Vellox/",
  "bugs": {
    "url": "https://github.com/Guimenn/Vellox/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "vellox",
    "finops",
    "performance",
    "database-optimizer",
    "sql",
    "static-analysis",
    "docker",
    "kubernetes",
    "terraform",
    "sarif",
    "prisma",
    "nplus1",
    "postgres",
    "mysql",
    "mongodb",
    "redis",
    "cli"
  ],
  "author": "Guilherme Men",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
